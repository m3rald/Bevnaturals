# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PAYSTACK_SECRET_KEY: Server-side Paystack secret key (sk_test_... or sk_live_...)
# When set, /api/orders and /api/paystack/verify execute live Paystack API calls.
PAYSTACK_SECRET_KEY=""

# VITE_PAYSTACK_PUBLIC_KEY: Public Paystack key (pk_test_... or pk_live_...)
VITE_PAYSTACK_PUBLIC_KEY=""

# STUDIO_PIN: Access PIN reference
STUDIO_PIN="Ibadanbev"

# SESSION_SECRET: HMAC signing secret
SESSION_SECRET=""

# STORE_OWNER_EMAIL: Store owner notification email (defaults to adereb18@gmail.com)
STORE_OWNER_EMAIL="adereb18@gmail.com"

# Email receipt dispatch (configure either Resend OR SMTP / Gmail App Password)
RESEND_API_KEY=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# Optional: Vercel KV / Upstash Redis REST API for durable cross-instance manual order storage on serverless deployments
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
