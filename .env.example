# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PAYSTACK_SECRET_KEY: Server-side Paystack secret key (sk_test_... or sk_live_...)
# When set, /api/orders and /api/paystack/verify execute live Paystack API calls.
PAYSTACK_SECRET_KEY=""

# VITE_PAYSTACK_PUBLIC_KEY: Public Paystack key (pk_test_... or pk_live_...)
VITE_PAYSTACK_PUBLIC_KEY=""

# STUDIO_PIN: Access PIN for the /admin Studio ledger (defaults to Ibadanbev)
STUDIO_PIN="Ibadanbev"

# SESSION_SECRET: HMAC signing secret for Studio admin sessions
SESSION_SECRET=""
